# Database — get a free Postgres instance from neon.tech or supabase.com
DATABASE_URL="postgresql://user:password@host:5432/idistinguishr"

# Auth.js
AUTH_SECRET="generate-with: npx auth secret"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe Connect (test mode keys from the Stripe dashboard)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Resend (confirmation emails)
RESEND_API_KEY=""

# Admin — comma-separated emails allowed onto /admin (teacher approval)
ADMIN_EMAILS=""

# Anthropic (automated first-pass teacher vetting — see src/lib/vet-teacher-profile.ts)
# Leave unset to skip AI vetting entirely: profiles just stay PENDING for manual review, as before.
ANTHROPIC_API_KEY=""
# TEACHER_VETTING_MODEL=""   # optional override; defaults to claude-haiku-4-5

# Absolute site URL, used only in the admin-review-needed email (every other link in the app is relative)
SITE_URL="https://idistinguishr.vercel.app"
